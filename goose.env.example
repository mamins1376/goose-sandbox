# Copy to goose.env, fill in ONE provider, and pass it with
#   GOOSE_ENV_FILE=./goose.env ./run.sh session
#
# This file is read by `podman run --env-file`, so no quoting and no comments
# after values. The host environment is NOT inherited — anything goose can see
# must be listed here.

# ---- pick a provider -------------------------------------------------------
GOOSE_PROVIDER=openai
GOOSE_MODEL=gpt-4o
OPENAI_API_KEY=sk-replace-me

# Other common shapes:
#   GOOSE_PROVIDER=anthropic   GOOSE_MODEL=claude-sonnet-4-5   ANTHROPIC_API_KEY=...
#   GOOSE_PROVIDER=ollama      GOOSE_MODEL=llama3.2           OLLAMA_HOST=http://host.containers.internal:11434
#   (podman also aliases host.docker.internal; docker users need that name instead)

# ---- safety knobs ----------------------------------------------------------
GOOSE_TELEMETRY_ENABLED=false
GOOSE_DISABLE_KEYRING=true

# ---- the timeout budgets this fork adds ------------------------------------
# Inter-chunk idle window (seconds). A gap longer than this is treated as a
# dead connection. Default 15.
GOOSE_INFERENCE_CHUNK_TIMEOUT_SECS=15
# Time-to-first-line budget (seconds). Default 120. Raise it for slow prefill
# on large contexts instead of raising the chunk timeout.
GOOSE_INFERENCE_FIRST_LINE_TIMEOUT_SECS=120
